# Copie para .env ou execute ./scripts/setup.sh para gerar valores seguros.
APP_PORT=3210
EVOLUTION_PORT=18080

# Banco exclusivo do WhatsErase
APP_DB_NAME=whats_erase
APP_DB_USER=whats_erase
APP_DB_PASSWORD=change-me-app-db

# Banco exclusivo da Evolution API
EVOLUTION_DB_NAME=evolution
EVOLUTION_DB_USER=evolution
EVOLUTION_DB_PASSWORD=change-me-evolution-db

# Segredos de infraestrutura. setup.sh gera todos automaticamente.
APP_ENCRYPTION_KEY=change-me-base64-32-bytes
SESSION_SECRET=change-me-at-least-32-characters
EVOLUTION_API_KEY=change-me-evolution-api-key

# Defaults entregues ao painel; podem ser alterados pela UI.
BUNDLED_EVOLUTION_URL=http://evolution:8080
PUBLIC_EVOLUTION_URL=http://localhost:18080
WEBHOOK_URL=http://app:3000/api/webhooks/evolution
